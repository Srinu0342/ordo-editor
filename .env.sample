# Ordo's settings. Copy this file to .env and edit it:
#
#   cp .env.sample .env
#
# The server reads .env once, at start-up, so restart it after a change.
# A variable already set in your shell wins over the file, so
# `PORT=5199 npm start` works with a .env in place. .env is not committed,
# and it is left out of the Docker image.

# The folder whose repos local mode can open. The repo picker starts here, and
# a repo in the URL is named relative to it (repo=payments-api under ~/code).
# A leading ~ is your home folder. Default: your home folder.
ORDO_WORKSPACE=~

# The port the editor, /api and /mcp share. Default: 5173.
PORT=5173

# The address to listen on. Keep it on loopback: Ordo has no login, and
# anything that can reach the port can read and write .ordo/ in your repos.
# Default: localhost.
HOST=localhost

# NODE_ENV is not set here: `npm run dev` and `npm start` choose it themselves.
